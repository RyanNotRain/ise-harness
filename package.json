{
  "name": "ise-harness",
  "version": "0.1.1",
  "description": "Coding Agent Harness SDK — 记忆与上下文管理",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "ise-harness": "dist/cli/index.js"
  },
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:demo": "vitest run tests/demo/",
    "build": "tsc",
    "start": "node dist/cli/index.js",
    "web": "node dist/cli/index.js web",
    "lint": "tsc --noEmit",
    "prepack": "npm run build",
    "prepublishOnly": "npm test && npm run lint"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "tsx": "^4.19.0"
  },
  "dependencies": {
    "sql.js": "^1.10.0"
  },
  "optionalDependencies": {
    "@xenova/transformers": "^2.17.0"
  }
}
